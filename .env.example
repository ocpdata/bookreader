DATABASE_URL="mysql://root:bookreader@localhost:3307/bookreader"
AWS_REGION=us-east-1
S3_BUCKET=resumen-book-reader
PORT=3000
SHARING_ENABLED=false
# URL pública HTTPS en la raíz, accesible desde el móvil (la guía no usa localhost).
# APP_PUBLIC_URL=https://audio.example.com
# ABS_COMPAT_ENABLED=false
# Acceso con Google (opcional). Cliente OAuth de tipo aplicación web con la URI de redirección
# <APP_PUBLIC_URL>/api/auth/google/callback; en desarrollo, http://localhost:5500/api/auth/google/callback.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
