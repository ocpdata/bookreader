generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum UserRole {
  USER
  ADMIN
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SummaryStatus {
  PENDING
  READY
}

// Usuario único hasta que exista el login. El id fijo se crea en la migración.
model User {
  id                String             @id @default(uuid()) @db.VarChar(36)
  name              String             @db.VarChar(100)
  email             String?            @unique @db.VarChar(255)
  passwordHash      String?            @map("password_hash") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at")
  // Identificador del proveedor externo (sub de Cognito) cuando se migre; nulo con el login propio.
  externalId        String?            @unique @map("external_id") @db.VarChar(64)
  // PENDIENTE hasta verificar el correo; SUSPENDIDO no puede entrar (ver scripts/user-admin.js).
  status            UserStatus         @default(ACTIVE)
  role              UserRole           @default(USER)
  emailVerifiedAt   DateTime?          @map("email_verified_at")
  termsAcceptedAt   DateTime?          @map("terms_accepted_at")
  termsVersion      String?            @map("terms_version") @db.VarChar(20)
  // Cuotas propias de esta cuenta; nulo = el valor por defecto del servicio (ver QuotaService).
  storageLimitBytes BigInt?            @map("storage_limit_bytes")
  maxAudios         Int?               @map("max_audios")
  lastLoginAt       DateTime?          @map("last_login_at")
  summaries         Summary[]
  progress          PlaybackProgress[]
  tags              Tag[]
  favorites         Favorite[]
  sessions          Session[]
  folders           Folder[]
  categories        Category[]
  apiTokens         ApiToken[]
  playSessions      PlaySession[]
  bookmarks         Bookmark[]
  emailTokens       EmailToken[]
  roleChangesMade   AdminRoleChange[]  @relation("RoleChangeActor")
  roleChangesReceived AdminRoleChange[] @relation("RoleChangeTarget")

  @@map("users")
}

model AdminRoleChange {
  id         String   @id @default(uuid()) @db.VarChar(36)
  actorId    String   @map("actor_id") @db.VarChar(36)
  targetId   String   @map("target_id") @db.VarChar(36)
  previousRole UserRole @map("previous_role")
  newRole    UserRole @map("new_role")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: Cascade)
  target     User     @relation("RoleChangeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetId, createdAt])
  @@map("admin_role_changes")
}

model Category {
  id        String    @id @default(uuid()) @db.VarChar(36)
  name      String    @db.VarChar(100)
  // Solo las predeterminadas usan este campo; permite su unicidad pese a userId nulo en MySQL.
  sharedName String?  @unique @map("shared_name") @db.VarChar(100)
  userId    String?   @map("user_id") @db.VarChar(36)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaries Summary[]

  @@unique([userId, name])
  @@map("categories")
}

model Summary {
  id               String             @id @default(uuid()) @db.VarChar(36)
  // El valor por defecto es temporal: mantiene compatible el release anterior tras un rollback.
  // Se elimina cuando exista el login.
  userId           String             @default("00000000-0000-4000-8000-000000000001") @map("user_id") @db.VarChar(36)
  user             User               @relation(fields: [userId], references: [id])
  progress         PlaybackProgress[]
  tags             SummaryTag[]
  favorites        Favorite[]
  playSessions     PlaySession[]
  bookmarks        Bookmark[]
  title            String             @db.VarChar(200)
  author           String             @db.VarChar(200)
  summaryTitle     String?            @map("summary_title") @db.VarChar(200)
  narrator         String?            @db.VarChar(200)
  description      String?            @db.Text
  durationSeconds  Int?               @map("duration_seconds")
  // Papelera: un audio eliminado conserva su fila y su archivo hasta que expire la retención.
  deletedAt        DateTime?          @map("deleted_at")
  // Carpeta del usuario donde vive el audio; nulo = raíz. Al borrar la carpeta se reubica antes (ver FoldersService).
  folderId         String?            @map("folder_id") @db.VarChar(36)
  folder           Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  categoryId       String             @map("category_id") @db.VarChar(36)
  category         Category           @relation(fields: [categoryId], references: [id])
  s3Key            String             @unique @map("s3_key") @db.VarChar(255)
  // Portada normalizada (JPEG) en el mismo prefijo del audio; nulo si no tiene.
  coverKey         String?            @map("cover_key") @db.VarChar(255)
  originalFilename String             @map("original_filename") @db.VarChar(255)
  sizeBytes        Int                @map("size_bytes")
  contentType      String             @map("content_type") @db.VarChar(100)
  uploadRequestId  String?            @map("upload_request_id") @db.VarChar(36)
  requestedSha256  String?            @map("requested_sha256") @db.Char(64)
  uploadIssuedAt   DateTime?          @map("upload_issued_at")
  cancelRequestedAt DateTime?         @map("cancel_requested_at")
  purgeClaimedAt   DateTime?          @map("purge_claimed_at")
  audioSha256      String?            @map("audio_sha256") @db.Char(64)
  hashAttemptAt    DateTime?          @map("hash_attempt_at")
  status           SummaryStatus      @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([folderId])
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
  @@index([status, createdAt])
  @@unique([userId, uploadRequestId])
  @@index([userId, audioSha256])
  @@map("summaries")
}

// Posición de escucha de cada usuario en cada audio. "completed" es persistente: solo cambia al
// llegar al ~95 %, de forma explícita o al reiniciar (se borra la fila).
model PlaybackProgress {
  userId           String   @map("user_id") @db.VarChar(36)
  summaryId        String   @map("summary_id") @db.VarChar(36)
  positionSeconds  Int      @default(0) @map("position_seconds")
  completed        Boolean  @default(false)
  // Oculto de "continuar escuchando" (apps de Audiobookshelf); se vuelve a mostrar al avanzar.
  hideFromContinue Boolean  @default(false) @map("hide_from_continue")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary          Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@id([userId, summaryId])
  @@index([userId, updatedAt])
  @@map("playback_progress")
}

// Etiquetas libres de cada usuario. La colación utf8mb4 ignora mayúsculas y acentos, así que
// "Ventas" y "ventas" son la misma etiqueta (se conserva la primera grafía).
model Tag {
  id        String       @id @default(uuid()) @db.VarChar(36)
  userId    String       @map("user_id") @db.VarChar(36)
  name      String       @db.VarChar(50)
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaries SummaryTag[]

  @@unique([userId, name])
  @@map("tags")
}

model SummaryTag {
  summaryId String  @map("summary_id") @db.VarChar(36)
  tagId     String  @map("tag_id") @db.VarChar(36)
  summary   Summary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([summaryId, tagId])
  @@index([tagId])
  @@map("summary_tags")
}

model Favorite {
  userId    String   @map("user_id") @db.VarChar(36)
  summaryId String   @map("summary_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@id([userId, summaryId])
  @@index([summaryId])
  @@map("favorites")
}

// Sesión de servidor. En la base solo se guarda el hash del token; el token vive en la cookie.
model Session {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Carpetas jerárquicas de cada usuario. Un audio está en una sola carpeta (summaries.folder_id).
// La unicidad del nombre entre hermanas la garantiza el índice único (salvo en la raíz, donde
// parent_id es nulo y MySQL no lo aplica) y, sobre todo, FoldersService, que serializa las
// escrituras de cada usuario.
model Folder {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  parentId  String?   @map("parent_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderTree")
  summaries Summary[]

  @@unique([userId, parentId, name])
  @@index([parentId])
  @@map("folders")
}

// Token de un dispositivo (apps compatibles con Audiobookshelf). Solo se guarda el hash; se puede revocar.
model ApiToken {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  name       String    @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// Sesión de reproducción de una app compatible: su id (aleatorio) autoriza la URL pública del audio.
model PlaySession {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  summaryId  String   @map("summary_id") @db.VarChar(36)
  deviceName String?  @map("device_name") @db.VarChar(100)
  startTime  Int      @default(0) @map("start_time")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary    Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("play_sessions")
}

// Marcador de un usuario en un audio (apps compatibles con Audiobookshelf). El tiempo en segundos, con milisegundos,
// identifica el marcador: las apps lo editan y borran por su posición.
model Bookmark {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  summaryId   String   @map("summary_id") @db.VarChar(36)
  timeSeconds Float    @map("time_seconds")
  title       String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary     Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryId, timeSeconds])
  @@index([summaryId])
  @@map("bookmarks")
}

// Enlace de un solo uso enviado por correo (verificar el correo o restablecer la contraseña). Solo se guarda el hash.
model EmailToken {
  id        String            @id @default(uuid()) @db.VarChar(36)
  userId    String            @map("user_id") @db.VarChar(36)
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

// Código de invitación para el registro en modo "invite". Se guarda solo el hash; lo crea el administrador por CLI.
model Invitation {
  id        String    @id @default(uuid()) @db.VarChar(36)
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  // Si se indica, solo ese correo puede usarla.
  email     String?   @db.VarChar(255)
  maxUses   Int       @default(1) @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")
  note      String?   @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}
